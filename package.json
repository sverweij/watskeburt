{
  "name": "watskeburt",
  "version": "6.0.0",
  "description": "List files changed since a git revision",
  "keywords": [
    "git",
    "diff"
  ],
  "homepage": "https://github.com/sverweij/watskeburt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sverweij/watskeburt.git"
  },
  "bugs": {
    "url": "https://github.com/sverweij/watskeburt/issues"
  },
  "author": {
    "name": "Sander Verweij",
    "url": "https://sverweij.github.io"
  },
  "license": "MIT",
  "bin": {
    "watskeburt": "dist/run-cli.js"
  },
  "main": "dist/main.js",
  "module": "dist/main.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": [
      {
        "types": "./types/watskeburt.d.ts",
        "import": "./dist/main.js"
      },
      "./dist/main.js"
    ]
  },
  "types": "types/watskeburt.d.ts",
  "files": [
    "dist",
    "!**/*.DS_Store",
    "types",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "26.6.2",
    "c8": "12.0.0",
    "clean-pkg-json": "2.0.0",
    "dependency-cruiser": "18.4.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "upem": "11.0.1"
  },
  "engines": {
    "node": "^22.13||^24||>=26"
  },
  "scripts": {
    "build": "rm -rf dist && node --run=build:version && node --run=build:dist && node --run=build:format",
    "build:version": "node tools/get-version.ts > src/version.ts",
    "build:dist": "tsc",
    "build:format": "prettier --log-level warn --write --use-tabs dist/",
    "check": "node --run=format && node --run=lint && node --run=depcruise && node --run=test:cover",
    "test": "tsx --test-reporter ./tools/dot-with-summary.reporter.js --test src/*.spec.ts src/**/*.spec.ts",
    "test:cover": "c8 node --run=test",
    "depcruise": "dependency-cruiser dist src types",
    "depcruise:graph": "dependency-cruiser src types --include-only '^(dist|src|types)' --output-type dot | dot -T svg | tee docs/dependency-graph.svg | depcruise-wrap-stream-in-html > docs/dependency-graph.html",
    "depcruise:graph:dev": "dependency-cruiser dist src types --include-only '^(dist|src|types)' --prefix vscode://file/$(pwd)/ --output-type dot-webpage | browser",
    "depcruise:graph:diff:dev": "dependency-cruiser dist src types --include-only '^(dist|src|types)' --highlight \"$(node dist/run-cli.js main -T regex)\" --prefix vscode://file/$(pwd)/ --output-type dot-webpage| browser",
    "depcruise:graph:diff:mermaid": "dependency-cruiser dist src types --include-only '^(dist|src|types)' --output-type mermaid --output-to - --highlight \"$(node dist/run-cli.js $SHA -T regex)\"",
    "depcruise:html": "dependency-cruiser src types --progress --output-type err-html --output-to dependency-violation-report.html",
    "depcruise:text": "dependency-cruiser src types --progress --output-type text",
    "depcruise:focus": "dependency-cruiser src types --progress --output-type text --focus",
    "depcruise:reaches": "dependency-cruiser src types --progress --output-type text --reaches",
    "format": "prettier --log-level warn --write \"{src,tools}/**/*.{js,ts}\" \"types/**/*.ts\" \"*.{json,yml,md,js}\" \"!package-lock.json\"",
    "format:check": "prettier --log-level warn --check \"{src,tools}/**/*.ts\" \"types/**/*.ts\" \"*.{json,yml,md,js}\" \"!package-lock.json\"",
    "lint": "node --run=format:check && node --run=lint:es && node --run=lint:types",
    "lint:fix": "node --run=format && node --run=lint:es:fix",
    "lint:es": "oxlint src types tools",
    "lint:es:fix": "oxlint src types tools --fix",
    "lint:types": "tsc --noEmit",
    "prepack": "clean-pkg-json --dry | jq '.scripts = {test: \"echo see github for test, build and analysis scripts\"}' > smol-package.json && mv smol-package.json package.json && prettier --log-level warn --write --use-tabs package.json types",
    "postpack": "git restore package.json types",
    "scm:stage": "git add .",
    "update-dependencies": "node --run=upem:update && node --run=upem:install && node --run=lint:fix && node --run=check",
    "upem-outdated": "npm outdated --json --long | upem --dry-run",
    "upem:install": "npm install",
    "upem:update": "npm outdated --json --long | upem | pbcopy && pbpaste",
    "version": "node --run=build && node --run=lint && node --run=depcruise:graph && node --run=scm:stage"
  },
  "upem": {
    "policies": [
      {
        "package": "typescript",
        "policy": "wanted",
        "because": "we want to stay on version 6 This is OK - as we use it as devDependency for testing purposes only"
      }
    ]
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
